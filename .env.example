# Optional: pin Kaggle's image to a digest for reproducible competition runs.
KAGGLE_BASE=gcr.io/kaggle-gpu-images/python

# Used by the local JupyterLab server. Change this value.
JUPYTER_TOKEN=change-me
# make eval-model sets ADK_MODEL=local/qwen3-vl-4b-instruct automatically.
# VLM_API_BASE=http://vlm:8080/v1
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Deliberation builds procedures; fast execution chooses one token. Budgets are seconds.
COGNITION_REPAIR_ATTEMPTS=1
COGNITION_MAX_RESETS=2
COGNITION_SECONDS=600
COGNITION_DECISION_SECONDS=45

# make benchmark limits, per game (override with make benchmark EVAL_SECONDS=...).
# Keep EVAL_HARD_SECONDS greater than EVAL_SECONDS for initialization/cleanup.
EVAL_GAMES=ls20,vc33,ft09
EVAL_STEPS=12
EVAL_LEVELS=1
EVAL_SECONDS=90
EVAL_HARD_SECONDS=110
# Optional structured trace + latest memory snapshot (ignored by Git).
# Local Compose runs save decision/tool logs by default. Set empty to disable.
COGNITION_LOG_DIR=outputs/cognition
